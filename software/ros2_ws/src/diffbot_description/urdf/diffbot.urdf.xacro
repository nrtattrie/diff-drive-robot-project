<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="diffbot">

  <xacro:arg name="use_ros2_control" default="false"/>
  <xacro:arg name="controllers_file" default=""/>

  <!-- SIMULATION PARAMETERS -->
  <xacro:property name="chassis_length" value="0.25"/>
  <xacro:property name="chassis_width" value="0.18"/>
  <xacro:property name="chassis_height" value="0.06"/>
  <xacro:property name="chassis_mass" value="1.0"/>

  <xacro:property name="wheel_radius" value="0.04"/>
  <xacro:property name="wheel_width" value="0.01"/>
  <xacro:property name="wheel_mass" value="0.05"/>

  <!-- base_link is at the wheel axle centerline. -->
  <xacro:property name="chassis_z" value="${chassis_height / 2.0}"/>
  <xacro:property name="wheel_x" value="${chassis_length / 4.0}"/>
  <xacro:property name="wheel_y" value="0.095"/>
  <xacro:property name="wheel_z" value="0.0"/>

  <xacro:property name="caster_radius" value="${wheel_radius / 2.0}"/>
  <xacro:property name="caster_x" value="${-chassis_length / 4.0}"/>
  <xacro:property name="caster_z" value="${caster_radius - wheel_radius}"/>
  <xacro:property name="caster_mass" value="0.02"/>

  <xacro:macro name="box_inertia" params="mass x y z">
    <inertial>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass * (y*y + z*z) / 12.0}" ixy="0" ixz="0"
        iyy="${mass * (x*x + z*z) / 12.0}" iyz="0"
        izz="${mass * (x*x + y*y) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="wheel_inertia" params="mass radius width">
    <inertial>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass * (3*radius*radius + width*width) / 12.0}" ixy="0" ixz="0"
        iyy="${mass * radius*radius / 2.0}" iyz="0"
        izz="${mass * (3*radius*radius + width*width) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="mass radius">
    <inertial>
      <mass value="${mass}"/>
      <inertia
        ixx="${2.0 * mass * radius*radius / 5.0}" ixy="0" ixz="0"
        iyy="${2.0 * mass * radius*radius / 5.0}" iyz="0"
        izz="${2.0 * mass * radius*radius / 5.0}"/>
    </inertial>
  </xacro:macro>

  <!-- BASE LINK -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${chassis_z}" rpy="0 0 0"/>
      <geometry>
          <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="white">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 ${chassis_z}" rpy="0 0 0"/>
      <geometry>
          <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertia mass="${chassis_mass}" x="${chassis_length}" y="${chassis_width}" z="${chassis_height}"/>
  </link>

  <!-- WHEEL LINK -->
  <xacro:macro name="wheel" params="name">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="1.57075 0 0"/>
        <geometry>
            <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="black">
          <color rgba="0 0 0 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.57075 0 0"/>
        <geometry>
            <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <xacro:wheel_inertia mass="${wheel_mass}" radius="${wheel_radius}" width="${wheel_width}"/>
    </link>
  </xacro:macro>

  <xacro:wheel name="left_wheel"/>
  <xacro:wheel name="right_wheel"/>

  <!-- CASTER LINK -->
  <xacro:macro name="caster" params="name">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0.0" rpy="0 0 0"/>
        <geometry>
              <sphere radius="${caster_radius}"/>
        </geometry>
        <material name="black">
          <color rgba="0 0 0 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
            <sphere radius="${caster_radius}"/>
        </geometry>
      </collision>
      <xacro:sphere_inertia mass="${caster_mass}" radius="${caster_radius}"/>
    </link>
  </xacro:macro>

  <xacro:caster name="caster"/>


  <!-- JOINTS -->
  <joint name="base_link_to_left_wheel" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="${wheel_x} ${wheel_y} ${wheel_z}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="base_link_to_right_wheel" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="${wheel_x} -${wheel_y} ${wheel_z}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="base_link_to_caster" type="fixed">
    <parent link="base_link"/>
    <child link="caster"/>
    <origin xyz="${caster_x} 0 ${caster_z}" rpy="0 0 0"/>
  </joint>

  <xacro:unless value="$(arg use_ros2_control)">
    <gazebo>
      <plugin filename="gz-sim-joint-state-publisher-system"
              name="gz::sim::systems::JointStatePublisher">
      </plugin>

      <plugin filename="gz-sim-diff-drive-system"
              name="gz::sim::systems::DiffDrive">
        <left_joint>base_link_to_left_wheel</left_joint>
        <right_joint>base_link_to_right_wheel</right_joint>
        <wheel_separation>${2 * wheel_y}</wheel_separation>
        <wheel_radius>${wheel_radius}</wheel_radius>
        <odom_publish_frequency>30</odom_publish_frequency>
        <max_linear_velocity>0.5</max_linear_velocity>
        <min_linear_velocity>-0.5</min_linear_velocity>
        <max_angular_velocity>1.0</max_angular_velocity>
        <min_angular_velocity>-1.0</min_angular_velocity>
      </plugin>
    </gazebo>
  </xacro:unless>

  <xacro:if value="$(arg use_ros2_control)">
    <ros2_control name="GazeboSimSystem" type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>

      <joint name="base_link_to_left_wheel">
        <command_interface name="velocity">
          <param name="min">-10</param>
          <param name="max">10</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="base_link_to_right_wheel">
        <command_interface name="velocity">
          <param name="min">-10</param>
          <param name="max">10</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </ros2_control>

    <gazebo>
      <plugin filename="gz_ros2_control-system"
              name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(arg controllers_file)</parameters>
      </plugin>
    </gazebo>
  </xacro:if>

</robot>
